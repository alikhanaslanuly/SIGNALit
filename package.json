{
  "name": "signal-hospital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server:dev": "node --import tsx server/src/index.ts",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "test:realtime": "node --import tsx tests/realtime-smoke.ts",
    "test:e2e": "tsc -p tsconfig.e2e.json --noEmit && playwright test",
    "demo": "node scripts/demo.mjs",
    "preflight": "node scripts/checks.mjs",
    "verify": "node scripts/checks.mjs --full",
    "server:build": "tsc -p server/tsconfig.build.json",
    "start": "node scripts/start-server.mjs",
    "submission:check": "node scripts/submission-check.mjs",
    "test:judge": "playwright test --grep \"judge demo lifecycle\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "node-mocks-http": "^1.17.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
